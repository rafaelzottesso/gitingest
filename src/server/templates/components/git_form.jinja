<div class="relative">
    <div class="w-full h-full absolute inset-0 bg-gray-900 rounded-xl translate-y-2 translate-x-2"></div>
    <div class="rounded-xl relative z-20 p-8 sm:p-10 border-[3px] border-gray-900 bg-[#fff4da]">
        <img src="https://cdn.devdojo.com/images/january2023/shape-1.png"
             class="absolute md:block hidden left-0 h-[4.5rem] w-[4.5rem] bottom-0 -translate-x-full ml-3">
        <!-- Ingest Form -->
        <form id="ingestForm" method="post" onsubmit="handleSubmit(event, true)">
            <!-- Top row: repo URL + Ingest button -->
            <div class="flex md:flex-row flex-col w-full h-full justify-center items-stretch space-y-5 md:space-y-0 md:space-x-5">
                <!-- Repository URL Input -->
                <div class="relative w-full h-full">
                    <div class="w-full h-full rounded bg-gray-900 translate-y-1 translate-x-1 absolute inset-0 z-10"></div>
                    <input type="text"
                           name="input_text"
                           id="input_text"
                           placeholder="https://github.com/..."
                           value="{{ repo_url if repo_url else '' }}"
                           required
                           class="border-[3px] w-full relative z-20 border-gray-900 placeholder-gray-600 text-lg font-medium focus:outline-none py-3.5 px-6 rounded bg-[#E8F0FE]">
                </div>
                <!-- Ingest button -->
                <div class="relative w-auto flex-shrink-0 h-full group">
                    <div class="w-full h-full rounded bg-gray-800 translate-y-1 translate-x-1 absolute inset-0 z-10"></div>
                    <button type="submit"
                            class="py-3.5 rounded px-6 group-hover:-translate-y-px group-hover:-translate-x-px ease-out duration-300 z-20 relative w-full border-[3px] border-gray-900 font-medium bg-[#ffc480] tracking-wide text-lg flex-shrink-0 text-gray-900">
                        Ingest
                    </button>
                </div>
            </div>
            <!-- Pattern inputs (include and exclude can be used together) -->
            <div class="w-full flex flex-col gap-3 mt-7">
                <div class="flex justify-end -mb-1">
                    <button type="button"
                            onclick="PatternTags.openModal()"
                            class="text-sm text-gray-600 hover:text-gray-800 underline flex items-center gap-1">
                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-4m0-4h.01" />
                        </svg>
                        How do patterns work?
                    </button>
                </div>
                <div class="w-full relative">
                    <div class="w-full h-full rounded bg-gray-900 translate-y-1 translate-x-1 absolute inset-0 z-10"></div>
                    <div class="flex items-stretch relative z-20 border-[3px] border-gray-900 rounded bg-white">
                        <label for="include_pattern_input" class="pattern-select flex items-center">Include</label>
                        <div data-tag-box="include_pattern"
                             class="flex flex-wrap items-center gap-1.5 w-full p-1.5 bg-[#E8F0FE] cursor-text">
                            <input type="text"
                                   id="include_pattern_input"
                                   autocomplete="off"
                                   placeholder="Type a pattern, then comma or space"
                                   class="flex-1 min-w-[10rem] py-0.5 px-1 bg-transparent focus:outline-none">
                        </div>
                        <input type="hidden"
                               id="include_pattern"
                               name="include_pattern"
                               value="{{ include_pattern if include_pattern else '' }}">
                    </div>
                </div>
                <div class="w-full relative">
                    <div class="w-full h-full rounded bg-gray-900 translate-y-1 translate-x-1 absolute inset-0 z-10"></div>
                    <div class="flex items-stretch relative z-20 border-[3px] border-gray-900 rounded bg-white">
                        <label for="exclude_pattern_input" class="pattern-select flex items-center">Exclude</label>
                        <div data-tag-box="exclude_pattern"
                             class="flex flex-wrap items-center gap-1.5 w-full p-1.5 bg-[#E8F0FE] cursor-text">
                            <input type="text"
                                   id="exclude_pattern_input"
                                   autocomplete="off"
                                   placeholder="Type a pattern, then comma or space"
                                   class="flex-1 min-w-[10rem] py-0.5 px-1 bg-transparent focus:outline-none">
                        </div>
                        <input type="hidden"
                               id="exclude_pattern"
                               name="exclude_pattern"
                               value="{{ exclude_pattern if exclude_pattern else '' }}">
                    </div>
                </div>
            </div>
            <!-- Controls row: file size slider and PAT checkbox with PAT field below -->
            <div id="controlsRow" class="mt-7 grid gap-6 grid-cols-1 sm:grid-cols-2 md:gap-x-10">
                <!-- File size selector -->
                <div class="w-full self-center">
                    <label for="file_size" class="block text-gray-700 mb-1">
                        Include files under: <span id="size_value" class="font-bold">50kB</span>
                    </label>
                    <input type="range"
                           id="file_size"
                           min="1"
                           max="500"
                           required
                           value="{{ default_max_file_size }}"
                           class="w-full h-3 bg-[#FAFAFA] bg-no-repeat bg-[length:50%_100%] bg-[#ebdbb7] appearance-none border-[3px] border-gray-900 rounded-sm focus:outline-none bg-gradient-to-r from-[#FE4A60] to-[#FE4A60] [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:h-7 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:bg-white [&::-webkit-slider-thumb]:rounded-sm [&::-webkit-slider-thumb]:cursor-pointer [&::-webkit-slider-thumb]:border-solid [&::-webkit-slider-thumb]:border-[3px] [&::-webkit-slider-thumb]:border-gray-900 [&::-webkit-slider-thumb]:shadow-[3px_3px_0_#000]">
                    <input type="hidden" id="max_file_size_kb" name="max_file_size" value="">
                </div>
                <!-- PAT checkbox with PAT field below -->
                <div class="flex flex-col items-start w-full ">
                    <!-- PAT checkbox -->
                    <div class="flex items-center space-x-2">
                        <label for="showAccessSettings"
                               class="flex gap-2 text-gray-900 cursor-pointer">
                            <div class="relative w-6 h-6">
                                <input type="checkbox"
                                       id="showAccessSettings"
                                       onchange="toggleAccessSettings()"
                                       {% if token %}checked{% endif %}
                                       class="cursor-pointer peer appearance-none w-full h-full rounded-sm border-[3px] border-current bg-white m-0 text-current shadow-[3px_3px_0_currentColor]" />
                                <span class="absolute inset-0 w-3 h-3 m-auto scale-0 transition-transform duration-150 ease-in-out shadow-[inset_1rem_1rem_#FE4A60] bg-[CanvasText] origin-bottom-left peer-checked:scale-100"
                                      style="clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%)"></span>
                            </div>
                            Private Repository
                        </label>
                        <span class="badge-new">NEW</span>
                    </div>
                    <!-- PAT field -->
                    <div id="accessSettingsContainer"
                         class="{% if not token %}hidden {% endif %}mt-3 w-full">
                        <div class="relative w-full">
                            <div class="w-full h-full rounded bg-gray-900 translate-y-1 translate-x-1 absolute inset-0 z-10"></div>
                            <div class="flex relative z-20 border-[3px] border-gray-900 rounded bg-white">
                                <input id="token"
                                       type="password"
                                       name="token"
                                       placeholder="Personal Access Token"
                                       value="{{ token if token else '' }}"
                                       class="py-2 pl-2 pr-8 bg-[#E8F0FE] focus:outline-none w-full rounded">
                                <!-- Info icon with tooltip -->
                                <span class="absolute right-3 top-1/2 -translate-y-1/2">
                                    <!-- Icon -->
                                    <svg class="w-4 h-4 text-gray-600 cursor-pointer peer"
                                         xmlns="http://www.w3.org/2000/svg"
                                         fill="none"
                                         viewBox="0 0 24 24"
                                         stroke="currentColor"
                                         stroke-width="2">
                                        <circle cx="12" cy="12" r="10" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-4m0-4h.01" />
                                    </svg>
                                    <!-- Tooltip (tooltip listens to peer-hover) -->
                                    <div class="absolute bottom-full mb-2 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs leading-tight py-1 px-2 rounded shadow-lg opacity-0 pointer-events-none peer-hover:opacity-100 peer-hover:pointer-events-auto transition-opacity duration-200 whitespace-nowrap">
                                        <ul class="list-disc pl-4">
                                            <li>PAT is never stored in the backend</li>
                                            <li>Used once for cloning, then discarded from memory</li>
                                            <li>No browser caching</li>
                                            <li>Cloned repos are deleted after processing</li>
                                        </ul>
                                    </div>
                                </span>
                            </div>
                        </div>
                        <!-- Help section -->
                        <div class="mt-2 flex items-center space-x-1">
                            <a href="https://github.com/settings/tokens/new?description=gitingest&scopes=repo"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="text-sm text-gray-600 hover:text-gray-800 flex items-center space-x-1 underline">
                                <span>Get your token</span>
                                <svg class="w-3 h-3"
                                     fill="none"
                                     stroke="currentColor"
                                     viewBox="0 0 24 24"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Compression options (reduce tokens sent to LLMs) -->
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-gray-900">
                <span class="text-gray-700">Reduce tokens:</span>
                <label for="compact_whitespace"
                       class="flex items-center gap-2 text-gray-900 cursor-pointer"
                       title="Trim trailing spaces, collapse blank lines, 4-space indent to 2">
                    <div class="relative w-6 h-6">
                        <input type="checkbox"
                               id="compact_whitespace"
                               name="compact_whitespace"
                               class="cursor-pointer peer appearance-none w-full h-full rounded-sm border-[3px] border-current bg-white m-0 text-current shadow-[3px_3px_0_currentColor]">
                        <span class="absolute inset-0 w-3 h-3 m-auto scale-0 transition-transform duration-150 ease-in-out shadow-[inset_1rem_1rem_#FE4A60] bg-[CanvasText] origin-bottom-left peer-checked:scale-100"
                              style="clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%)"></span>
                    </div>
                    Compact whitespace
                </label>
                <label for="strip_comments"
                       class="flex items-center gap-2 text-gray-900 cursor-pointer"
                       title="Remove comments and Python docstrings (Python, JS/TS, Java, C-family, Go, Rust, shell, YAML...)">
                    <div class="relative w-6 h-6">
                        <input type="checkbox"
                               id="strip_comments"
                               name="strip_comments"
                               class="cursor-pointer peer appearance-none w-full h-full rounded-sm border-[3px] border-current bg-white m-0 text-current shadow-[3px_3px_0_currentColor]">
                        <span class="absolute inset-0 w-3 h-3 m-auto scale-0 transition-transform duration-150 ease-in-out shadow-[inset_1rem_1rem_#FE4A60] bg-[CanvasText] origin-bottom-left peer-checked:scale-100"
                              style="clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%)"></span>
                    </div>
                    Remove comments
                </label>
                <label for="compact_format"
                       class="flex items-center gap-2 text-gray-900 cursor-pointer"
                       title="Short file headers and a plain indented tree instead of ==== and box characters">
                    <div class="relative w-6 h-6">
                        <input type="checkbox"
                               id="compact_format"
                               name="compact_format"
                               class="cursor-pointer peer appearance-none w-full h-full rounded-sm border-[3px] border-current bg-white m-0 text-current shadow-[3px_3px_0_currentColor]">
                        <span class="absolute inset-0 w-3 h-3 m-auto scale-0 transition-transform duration-150 ease-in-out shadow-[inset_1rem_1rem_#FE4A60] bg-[CanvasText] origin-bottom-left peer-checked:scale-100"
                              style="clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%)"></span>
                    </div>
                    Compact format
                </label>
            </div>
        </form>
        <!-- Example repositories section -->
        {% if show_examples %}
            <div id="exampleRepositories"
                 class="{% if token %}lg:mt-0 {% endif %} mt-4">
                <p class="opacity-70 mb-1">Try these example repositories:</p>
                <div class="flex flex-wrap gap-2">
                    {% for example in examples %}
                        <button onclick="submitExample('{{ example.url }}')"
                                class="px-4 py-1 bg-[#EBDBB7] hover:bg-[#FFC480] text-gray-900 rounded transition-colors duration-200 border-[3px] border-gray-900 relative hover:-translate-y-px hover:-translate-x-px">
                            {{ example.name }}
                        </button>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        <!-- Pattern help modal -->
        <div id="patternHelpModal"
             class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 sm:p-8 bg-gray-900/50 overflow-y-auto"
             onclick="if (event.target === this) PatternTags.closeModal()">
            <div class="relative w-full max-w-2xl my-auto">
                <div class="w-full h-full absolute inset-0 bg-gray-900 rounded-xl translate-y-2 translate-x-2"></div>
                <div class="relative z-10 max-h-[calc(100vh-4rem)] sm:max-h-[calc(100vh-6rem)] overflow-y-auto rounded-xl border-[3px] border-gray-900 bg-[#fff4da] p-5 sm:p-8 text-gray-900">
                    <div class="flex items-start justify-between gap-4 mb-3">
                        <h2 class="text-xl font-bold">Include &amp; Exclude patterns</h2>
                        <button type="button"
                                onclick="PatternTags.closeModal()"
                                aria-label="Close"
                                class="px-2 border-[3px] border-gray-900 rounded bg-[#ffc480] font-bold leading-snug">&times;</button>
                    </div>
                    <ul class="list-disc pl-5 space-y-1 text-sm text-gray-800 mb-4">
                        <li>Each pattern becomes a block. Type it and press <b>comma</b> or <b>space</b> to create it; click the <b>x</b> (or Backspace) to remove it.</li>
                        <li>You can <b>paste a whole list</b> such as <code class="font-mono">*.py, *.md, tests/*</code> and it is split into blocks automatically.</li>
                        <li><b>Include</b> keeps only matching files. <b>Exclude</b> removes matching files. Both can be used together.</li>
                        <li>Patterns follow <code class="font-mono">.gitignore</code> style: <code class="font-mono">*</code> matches any characters, a trailing <code class="font-mono">/</code> means a directory, and <code class="font-mono">*/name/*</code> matches a folder at any depth.</li>
                        <li>Patterns cannot contain spaces (a space separates two patterns).</li>
                        <li>After an ingest, <b>click a line in the directory tree</b> to add or remove it from Exclude.</li>
                    </ul>
                    <h3 class="font-bold mb-1">Examples</h3>
                    <ul>
                        <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-gray-900/20">
                            <code class="font-mono text-sm bg-[#ffc480] border-2 border-gray-900 rounded px-2 py-0.5">*.py</code>
                            <span class="flex-1 min-w-[8rem] text-sm text-gray-700">Every Python file</span>
                            <span class="flex gap-2 ml-auto">
                            <button type="button" onclick="PatternTags.addExample('include_pattern', '*.py', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Include</button>
                            <button type="button" onclick="PatternTags.addExample('exclude_pattern', '*.py', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Exclude</button>
                            </span>
                        </li>
                        <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-gray-900/20">
                            <code class="font-mono text-sm bg-[#ffc480] border-2 border-gray-900 rounded px-2 py-0.5">*.min.js</code>
                            <span class="flex-1 min-w-[8rem] text-sm text-gray-700">Minified JS files</span>
                            <span class="flex gap-2 ml-auto">
                            <button type="button" onclick="PatternTags.addExample('include_pattern', '*.min.js', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Include</button>
                            <button type="button" onclick="PatternTags.addExample('exclude_pattern', '*.min.js', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Exclude</button>
                            </span>
                        </li>
                        <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-gray-900/20">
                            <code class="font-mono text-sm bg-[#ffc480] border-2 border-gray-900 rounded px-2 py-0.5">src/</code>
                            <span class="flex-1 min-w-[8rem] text-sm text-gray-700">The whole src directory</span>
                            <span class="flex gap-2 ml-auto">
                            <button type="button" onclick="PatternTags.addExample('include_pattern', 'src/', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Include</button>
                            <button type="button" onclick="PatternTags.addExample('exclude_pattern', 'src/', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Exclude</button>
                            </span>
                        </li>
                        <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-gray-900/20">
                            <code class="font-mono text-sm bg-[#ffc480] border-2 border-gray-900 rounded px-2 py-0.5">*/migrations/*</code>
                            <span class="flex-1 min-w-[8rem] text-sm text-gray-700">Any migrations folder, at any depth</span>
                            <span class="flex gap-2 ml-auto">
                            <button type="button" onclick="PatternTags.addExample('include_pattern', '*/migrations/*', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Include</button>
                            <button type="button" onclick="PatternTags.addExample('exclude_pattern', '*/migrations/*', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Exclude</button>
                            </span>
                        </li>
                        <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-gray-900/20">
                            <code class="font-mono text-sm bg-[#ffc480] border-2 border-gray-900 rounded px-2 py-0.5">node_modules/*</code>
                            <span class="flex-1 min-w-[8rem] text-sm text-gray-700">Dependencies folder</span>
                            <span class="flex gap-2 ml-auto">
                            <button type="button" onclick="PatternTags.addExample('include_pattern', 'node_modules/*', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Include</button>
                            <button type="button" onclick="PatternTags.addExample('exclude_pattern', 'node_modules/*', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Exclude</button>
                            </span>
                        </li>
                        <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-gray-900/20">
                            <code class="font-mono text-sm bg-[#ffc480] border-2 border-gray-900 rounded px-2 py-0.5">README.md</code>
                            <span class="flex-1 min-w-[8rem] text-sm text-gray-700">One specific file</span>
                            <span class="flex gap-2 ml-auto">
                            <button type="button" onclick="PatternTags.addExample('include_pattern', 'README.md', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Include</button>
                            <button type="button" onclick="PatternTags.addExample('exclude_pattern', 'README.md', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Exclude</button>
                            </span>
                        </li>
                        <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-gray-900/20">
                            <code class="font-mono text-sm bg-[#ffc480] border-2 border-gray-900 rounded px-2 py-0.5">base*.html</code>
                            <span class="flex-1 min-w-[8rem] text-sm text-gray-700">Files starting with base</span>
                            <span class="flex gap-2 ml-auto">
                            <button type="button" onclick="PatternTags.addExample('include_pattern', 'base*.html', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Include</button>
                            <button type="button" onclick="PatternTags.addExample('exclude_pattern', 'base*.html', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Exclude</button>
                            </span>
                        </li>
                        <li class="flex flex-wrap items-center gap-2 py-1.5 border-b border-gray-900/20">
                            <code class="font-mono text-sm bg-[#ffc480] border-2 border-gray-900 rounded px-2 py-0.5">*/templates/*</code>
                            <span class="flex-1 min-w-[8rem] text-sm text-gray-700">Any templates folder</span>
                            <span class="flex gap-2 ml-auto">
                            <button type="button" onclick="PatternTags.addExample('include_pattern', '*/templates/*', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Include</button>
                            <button type="button" onclick="PatternTags.addExample('exclude_pattern', '*/templates/*', this)" class="text-xs px-2 py-0.5 bg-[#EBDBB7] hover:bg-[#FFC480] border-2 border-gray-900 rounded">+ Exclude</button>
                            </span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<script defer src="/static/js/git.js"></script>
<script defer src="/static/js/pattern_tags.js"></script>
<script defer src="/static/js/git_form.js"></script>
